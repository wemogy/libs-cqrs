<Project>
  <PropertyGroup>
    <DefaultTargetFrameworks>net10.0;net8.0</DefaultTargetFrameworks>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <CoverletOutput>$(SolutionDir)</CoverletOutput>
    <CoverletOutputFormat>json,lcov,cobertura</CoverletOutputFormat>
    <!-- Coverlet suffixes every output with the target framework (coverage.net8.0.json), so each
         test project has to merge into the file of its own framework; otherwise the last test
         project overwrites the report of all previous ones. -->
    <MergeWith>$(SolutionDir)coverage.$(TargetFramework).json</MergeWith>
    <!-- Test helpers (web app host, scanned fixture assemblies) are not library code. -->
    <Exclude>[*.TestWebApp]*,[*.UnitTests]*,[*.UnitTests.*]*</Exclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Wemogy.StyleCop">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
</Project>
